{
  "name": "@gram-saathi/server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for Gram Saathi. Every module serves mock data while USE_MOCKS is on.",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../.env --include .env src/index.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "ingest": "tsx scripts/ingest.ts",
    "prewarm": "tsx scripts/prewarm.ts",
    "query": "tsx scripts/query.ts",
    "calibrate": "tsx scripts/calibrate-rag.ts",
    "eval": "vitest run --silent=false --config vitest.eval.config.mts test/evalHarness.test.ts",
    "audit": "tsx scripts/audit.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "unpdf": "^2.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gram-saathi/shared": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
