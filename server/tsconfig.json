{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS output (package.json "type": "commonjs"): relative imports need no file extension.
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"]
}
