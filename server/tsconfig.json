{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // CommonJS output (package.json "type": "commonjs"): relative imports need no file extension.
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true
  },
  // Type-checks app code, scripts and tests. `npm run build` uses tsconfig.build.json (src only).
  "include": ["src", "scripts", "test", "../scripts", "vitest.config.mts"]
}
