# Copy to `.env` (git-ignored) and fill in. This ONE file at the repo root is read by both apps:
#   - server: all variables (loaded by server/src/config/env.ts)
#   - client: only VITE_* variables, which Vite bakes into the PUBLIC browser bundle.
# Never put a secret in a VITE_* variable.

# ---------- server ----------
# Google AI Studio API key (server only). Not needed while USE_MOCKS=true.
GEMINI_API_KEY=
# Model ids. TODO(step-2): pin current ids from https://ai.google.dev/gemini-api/docs/models
# (gemini-flash-latest is Google's alias for the newest Flash model.)
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
# true = every endpoint returns realistic multilingual mock data and makes no AI calls.
USE_MOCKS=true
PORT=4000
# Origins allowed by CORS (comma-separated). Add your deployed client URL here.
CLIENT_ORIGIN=http://localhost:5173

# ---------- client (public!) ----------
# Leave empty in dev: Vite proxies /api to the server on PORT.
# In production set the API origin, e.g. https://gram-saathi-api.example.com
VITE_API_URL=
# true = the browser serves client/src/mocks and never calls the server (frontend-only demo).
VITE_USE_MOCKS=false
