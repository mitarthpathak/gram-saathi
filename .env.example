# Copy to `.env` (git-ignored) and fill in. This ONE file at the repo root is read by both apps:
#   - server: all variables (loaded by server/src/config/env.ts; full list in docs/ARCHITECTURE.md)
#   - client: only VITE_* variables, which Vite bakes into the PUBLIC browser bundle.
# Never put a secret in a VITE_* variable. An empty value means "use the default".
# On Vercel, set these in Project Settings -> Environment Variables instead (docs/DEPLOYMENT.md).

# ---------- server ----------
# auto (default) = real Gemini pipeline when GEMINI_API_KEY is set, mock data when it is not.
# true = every endpoint returns realistic multilingual mock data and makes no AI calls
#        (the mic then always gets the same canned demo question, whatever you say).
# false = real Gemini pipeline (needs GEMINI_API_KEY and official scheme docs).
# Real mode uses server/data/vectorstore.json (`npm run ingest -w server` rebuilds it);
# `npm run prewarm -w server` is optional for the offline FAQ.
# A list such as `eligibility,sms` keeps only those modules mocked.
USE_MOCKS=auto
PORT=4000
# Origins allowed by CORS (comma-separated). Not needed when client and API share a domain.
CLIENT_ORIGIN=http://localhost:5173
# debug | info | warn | error (default: debug in development, info in production)
LOG_LEVEL=

# Google AI Studio API key (server only).
GEMINI_API_KEY=
# Models: https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Used when the primary model is temporarily unavailable; set to `none` to disable.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Speech-to-text model; empty = GEMINI_CHAT_MODEL.
GEMINI_AUDIO_MODEL=
# Server text-to-speech (POST /api/tts). Empty = the default below; `none` = browser voice only.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# TTS model for dialect-worded replies; `none` = use GEMINI_TTS_MODEL for them too.
GEMINI_TTS_DIALECT_MODEL=gemini-3.8-flash-tts
# Output sample rate: 16000 (smaller audio), 24000 or 8000. Falls back to 24000 if the API refuses it.
GEMINI_TTS_SAMPLE_RATE=16000
# Per-call speech timeout in ms (empty = GEMINI_TTS_TIMEOUT_MS, the older name, default 15000).
TTS_TIMEOUT_MS=
GEMINI_TTS_TIMEOUT_MS=15000
# Longer answers are split at sentence ends into pieces of at most this many characters.
TTS_MAX_CHARS=600
# One short constant delivery style, e.g. "calm and clear"; empty = none. Never use it for accents.
TTS_STYLE=
# Embeddings (used by `npm run ingest`; changing either needs a new ingest).
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIMENSIONS=768
# minimal | low | medium | high | default
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
# Shared process-wide Gemini cap. One slot remains available for answer-side work during classifier bursts.
GEMINI_MAX_CONCURRENT_CALLS=8

# Dialect identification. If these two variables are unset, the offline calibration file is used;
# these values are the fallback defaults when no calibration exists.
# DIALECT_ENSEMBLE_SIZE=3
# DIALECT_MIN_VOTES=2
DIALECT_TIMEOUT_MS=6000
# Typed text stays dialect-unclassified by default; confirmed dialectHint values always apply.
DIALECT_TEXT_DETECT=false
# "all" or a comma-separated set of registry dialect ids. Smaller sets mean higher accuracy.
DIALECT_ACTIVE=all
# Maximum consented native examples per label and shared prompt token budget.
DIALECT_EXEMPLARS_PER_LABEL=4
DIALECT_EXEMPLAR_TOKEN_BUDGET=1800
# Dialect wording of replies:
#   mirror (default) = like best_effort, and a spoken answer is also reworded to sound like the
#                      speaker's own words when the dialect is not identified with high confidence
#   best_effort      = only a confirmed or high-confidence dialect
#   verified_only    = only dialects marked verified by a native reviewer (dialect-render.json)
#   off              = always the standard language
# Facts (numbers, amounts, links, scheme names) are locked in every mode.
DIALECT_REPLY=mirror
# Longest wait (ms) for the dialect rewording step before the standard answer is used.
DIALECT_RENDER_TIMEOUT_MS=8000

# Retrieval: chunks per question, and the similarity a chunk needs (calibrate with npm run query -w server).
RAG_TOP_K=4
# The 0.5 default is uncalibrated; run `npm run calibrate -w server` and review the recommendation.
RAG_MIN_SCORE=0.5
# Translate non-English questions to English before searching (one extra Gemini call).
RAG_TRANSLATE_QUERY=false

# Answer cache (0 entries = off; 0 minutes = no expiry) and SMS length.
CACHE_MAX_ENTRIES=500
CACHE_TTL_MINUTES=360
SMS_MAX_SEGMENTS=2

# Abuse protection: requests per minute per IP to the AI endpoints (0 = no limit), and how many
# proxies sit in front of the server (1 on Vercel or behind the Vite dev proxy).
RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=1

# ---------- pipeline audit (optional; read only by `npm run audit -w server`) ----------
# Deployed app whose /api/health to probe, e.g. https://gram-saathi.vercel.app
# AUDIT_BASE_URL=
# Running client for the browser mic test (Stage H; needs Playwright), e.g. http://localhost:5173
# AUDIT_CLIENT_URL=
# Text questions per language in Stage D (default 3).
# AUDIT_TEXT_PER_LANGUAGE=3
# A free-text note about the machine the audit ran on (shown in the report).
# AUDIT_ENV_NOTE=
# Time limit per audit worker in ms (default 2700000 = 45 min).
# AUDIT_WORKER_TIMEOUT_MS=2700000

# ---------- client (public!) ----------
# Leave empty when client and API share an origin (Vite dev proxy, Vercel services).
# Otherwise the API origin, e.g. https://gram-saathi-api.example.com
VITE_API_URL=
# true = the browser serves client/src/mocks and never calls the server (frontend-only demo).
VITE_USE_MOCKS=false
